# Copy to .env for local runs (`python -m scraper.main`).
# In GitHub Actions, set these as repository secrets instead -
# see .github/workflows/nightly-scrape.yml.

# Supabase project (Settings -> API). The service role key bypasses
# RLS - never expose it to a browser/client.
SUPABASE_URL=https://zskqjwwcyczezouglzmi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Free key from https://developer.ticketmaster.com/ - powers the
# single highest-coverage source (Ticketmaster Discovery API).
TICKETMASTER_API_KEY=

# Optional, only needed for the Facebook Events scraper (selective
# small-venue sources, see config/sources.yaml Tier 4). Raw `Cookie:`
# header from a logged-in mbasic.facebook.com session. See
# scraper/sources/facebook_events.py.
FACEBOOK_COOKIE=

# Optional, only needed for the start.gg scraper (Smash Bros. Melee /
# Ultimate tournaments). Free token from
# https://developer.start.gg/docs/authentication.
STARTGG_API_KEY=

# Optional, only needed for the Songkick scraper (supplemental concert
# listings). Free key from
# https://www.songkick.com/api_key_requests/new.
SONGKICK_API_KEY=
